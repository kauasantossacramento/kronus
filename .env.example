# ══════════════════════════════════════════════════════════════
# Kronus — kronus.online
# KS TEC Soluções de Tecnologia Ltda — CNPJ 62.501.281/0001-13
# ══════════════════════════════════════════════════════════════

SECRET_KEY=your-secret-key-here
DEBUG=True
# Para testar o totem na rede local, inclua o IP da maquina:
#   ALLOWED_HOSTS=localhost,127.0.0.1,192.168.68.100
ALLOWED_HOSTS=localhost,127.0.0.1
# Origens confiaveis para CSRF (necessario fora de localhost)
CSRF_TRUSTED_ORIGINS=
DJANGO_SETTINGS_MODULE=config.settings.development

# ── Database ──────────────────────────────────────────────────
# DB_ENGINE: postgres (produção/homologação) | sqlite (bootstrap local)
DB_ENGINE=postgres
DB_NAME=kronus
DB_USER=kronus
DB_PASSWORD=your-db-password
DB_HOST=db
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
USE_REDIS=True

# ── Celery ────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# ── Storage (S3/MinIO) ────────────────────────────────────────
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=kronus
AWS_S3_ENDPOINT_URL=http://minio:9000

# ── Reconhecimento facial ─────────────────────────────────────
DEEPFACE_MODEL=ArcFace
# mtcnn (~460ms) em CPU; retinaface (~9.9s em CPU) apenas com GPU
DEEPFACE_DETECTOR=mtcnn
# 0.60 zerou falsos positivos no LFW; 0.68 (valor original do plano)
# produziu 5 falsos positivos em 435 pares. Ver SESSION_LOG_003.
FACE_RECOGNITION_THRESHOLD=0.60
# auto | deepface | deterministico | indisponivel
FACE_PROVIDER=auto
FACE_AMOSTRAS_MINIMAS=3
FACE_AMOSTRAS_MAXIMAS=5
FACE_GUARDAR_FRAME_TENTATIVA=False

# ── Email ─────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Kronus <nao-responda@kronus.online>

# ── Sentry ────────────────────────────────────────────────────
SENTRY_DSN=

# ── App ───────────────────────────────────────────────────────
APP_URL=https://kronus.online
APP_NAME=Kronus
KSTEC_LOGO_URL=https://kstec.online/assets/ks-tec-logo.png
KSTEC_SITE_URL=https://kstec.online
KSTEC_RAZAO_SOCIAL=KS TEC Soluções de Tecnologia Ltda
KSTEC_CNPJ=62.501.281/0001-13

# ── Segurança / Conformidade ──────────────────────────────────
HASH_SALT_GLOBAL=troque-este-salt-em-producao
FACE_RETENTION_DAYS_AFTER_TERMINATION=30
